# =========================================================
# HARGA / FEE
#
# WAJIB FORMAT NOMINAL DENGAN TITIK:
# BENAR : 1.000
# BENAR : 10.000
# SALAH : 1000
# SALAH : 1k
#
# Semua nilai di bawah adalah FEE TAMBAHAN.
# =========================================================

# =========================================================
# REGULAR VPS - DIGITALOCEAN WARRANTY PACKAGE FEE
# =========================================================
digitalocean_low=1.000
digitalocean_standard=2.000
digitalocean_high=3.000
digitalocean_super=5.000
digitalocean_gold=10.000

# =========================================================
# REGULAR VPS - LINODE WARRANTY PACKAGE FEE
# =========================================================
linode_low=1.000
linode_standard=2.000
linode_high=3.000
linode_super=5.000
linode_gold=10.000

# =========================================================
# REGULAR VPS - DIGITALOCEAN SPEC FEE
# Replace these example identifiers with actual provider plan IDs.
# =========================================================
digitalocean_vps_r8c4=1.000
digitalocean_vps_s4c8=2.000
digitalocean_vps_h8c16=5.000

# =========================================================
# REGULAR VPS - LINODE SPEC FEE
# =========================================================
linode_vps_r8c4=1.000
linode_vps_s4c8=2.000
linode_vps_h8c16=5.000

# =========================================================
# REGULAR VPS - OS FEE
# =========================================================
digitalocean_os_ubuntu=0
digitalocean_os_debian=0
linode_os_ubuntu=0
linode_os_debian=0

# =========================================================
# REGULAR VPS - REGION FEE
# =========================================================
digitalocean_region_sgp1=0
digitalocean_region_nyc3=0
linode_region_singapore=0
linode_region_newark=0

# =========================================================
# LEGAL VPS - DIGITALOCEAN SPEC FEE
# Separate from regular VPS pricing.
# =========================================================
digitalocean_legal_vps_r8c4=10.000
digitalocean_legal_vps_s4c8=15.000
digitalocean_legal_vps_h8c16=25.000

# =========================================================
# LEGAL VPS - LINODE SPEC FEE
# Separate from regular VPS pricing.
# =========================================================
linode_legal_vps_r8c4=12.000
linode_legal_vps_s4c8=18.000
linode_legal_vps_h8c16=30.000

# =========================================================
